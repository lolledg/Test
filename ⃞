local players = game:GetService("Players")
local runservice = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local client = players.LocalPlayer
local character = client.Character or client.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")
local hum = character:WaitForChild("Humanoid")

-- ==========================================
-- 1. VARIABLES BOOLEANAS Y REFERENCIAS
-- ==========================================
local desyncT = {
    enabled = true,
    isAttacking = false,
    loc = CFrame.new()
}

-- Pieza "nula" para romper la replicación (God Mode)
local nullPart = Instance.new("Part")
nullPart.Name = "DesyncDummy"
nullPart.Size = Vector3.zero
nullPart.Transparency = 1
nullPart.CanCollide = false
nullPart.Anchored = true
nullPart.Parent = workspace -- Debe estar en workspace para el CFrame

-- ==========================================
-- 2. HOOK METAMETHOD (Engaño al Cliente/Anticheat)
-- ==========================================
local oldIndex = nil
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    -- Si el desync está activo, no estamos atacando, y algo pregunta por el CFrame de nuestro HRP
    if not checkcaller() and key == "CFrame" and desyncT.enabled and not desyncT.isAttacking then
        if character and self == character:FindFirstChild("HumanoidRootPart") then
            return desyncT.loc -- Devolver la posición "falsa" (donde visualmente estamos)
        end
    end
    return oldIndex(self, key)
end))

-- ==========================================
-- 3. INTERFAZ MÓVIL
-- ==========================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "GodModeMobileGui"
local success = pcall(function() ScreenGui.Parent = CoreGui end)
if not success then ScreenGui.Parent = client:WaitForChild("PlayerGui") end

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 320, 0, 45)
Frame.Position = UDim2.new(0.5, -160, 0.05, 0)
Frame.BackgroundTransparency = 1
Frame.Parent = ScreenGui

local UpdateButton = Instance.new("TextButton")
UpdateButton.Size = UDim2.new(0.48, 0, 1, 0)
UpdateButton.Position = UDim2.new(0, 0, 0, 0)
UpdateButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
UpdateButton.TextColor3 = Color3.fromRGB(255, 255, 255)
UpdateButton.TextScaled = true
UpdateButton.Text = "Actualizar Pos"
UpdateButton.Parent = Frame
Instance.new("UICorner", UpdateButton).CornerRadius = UDim.new(0, 8)

local CombatButton = Instance.new("TextButton")
CombatButton.Size = UDim2.new(0.48, 0, 1, 0)
CombatButton.Position = UDim2.new(0.52, 0, 0, 0)
CombatButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
CombatButton.TextColor3 = Color3.fromRGB(255, 255, 255)
CombatButton.TextScaled = true
CombatButton.Text = "Modo: DIOS (ON)"
CombatButton.Parent = Frame
Instance.new("UICorner", CombatButton).CornerRadius = UDim.new(0, 8)

-- ==========================================
-- 4. FUNCIONES DE APOYO
-- ==========================================
local function toggleHumanoidStates(stateEnabled)
    if not hum then return end
    for _, state in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
        if state ~= Enum.HumanoidStateType.Dead and state ~= Enum.HumanoidStateType.None then
            pcall(function() hum:SetStateEnabled(state, stateEnabled) end)
        end
    end
end

local function actualizarPosicionReal(targetCFrame)
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = character.HumanoidRootPart
    
    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    
    if character.PrimaryPart then
        character:PivotTo(targetCFrame)
    end
    rootPart.CFrame = targetCFrame
    nullPart.CFrame = targetCFrame
    desyncT.loc = targetCFrame
end

-- ==========================================
-- 5. EVENTOS TÁCTILES
-- ==========================================
UpdateButton.MouseButton1Click:Connect(function()
    actualizarPosicionReal(nullPart.CFrame)
end)

CombatButton.MouseButton1Click:Connect(function()
    desyncT.isAttacking = not desyncT.isAttacking
    
    if desyncT.isAttacking then
        -- MODO COMBATE (Desync Pausado, puedes hacer daño)
        CombatButton.Text = "Modo: COMBATE"
        CombatButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        toggleHumanoidStates(true)
        
        if hrp then
            pcall(function() sethiddenproperty(hrp, "PhysicsRepRootRef", nil) end)
            pcall(function() sethiddenproperty(hrp, "NetworkIsSleeping", false) end)
        end
    else
        -- MODO DIOS (Desync Activo, eres intocable)
        CombatButton.Text = "Modo: DIOS (ON)"
        CombatButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        toggleHumanoidStates(false)
    end
end)

-- ==========================================
-- 6. EL BUCLE DE DESYNC DEFINITIVO
-- ==========================================
local sleepnet = true
local debounce = 0

runservice.Heartbeat:Connect(function()
    character = client.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Humanoid") then return end
    
    hrp = character.HumanoidRootPart
    hum = character.Humanoid
    
    if hum.Health <= 0 then return end

    if desyncT.enabled and not desyncT.isAttacking then
        debounce += 1
        
        -- Guardar nuestra posición real local
        desyncT.loc = hrp.CFrame
        nullPart.CFrame = desyncT.loc
        
        if not sleepnet then
            -- 1. Hook CFrame: Movemos el cuerpo al vacío temporalmente
            local newCframe = desyncT.loc * CFrame.new(0, 55, 0)
            hrp.CFrame = newCframe
            
            -- 2. God Mode Physics: Saturar el RootRef a la pieza nula
            for i = 1, 3 do
                pcall(function() sethiddenproperty(hrp, "PhysicsRepRootRef", nullPart) end)
            end
        else
            pcall(function() sethiddenproperty(hrp, "PhysicsRepRootRef", hrp) end)
        end
        
        -- 3. Network Sleep
        pcall(function() sethiddenproperty(hrp, "NetworkIsSleeping", sleepnet) end)
        
        runservice.RenderStepped:Wait()
        
        -- Restaurar posición visual local
        hrp.CFrame = desyncT.loc
        
        if debounce >= 3 then
            sleepnet = false
            debounce = 0
        else
            sleepnet = true
        end
    end
end)
