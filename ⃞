local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- 1. Buscar una Tool (ya sea equipada, en la mochila o tirada en el workspace)
local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

local tool = character:FindFirstChildOfClass("Tool") 
    or (backpack and backpack:FindFirstChildOfClass("Tool"))
    or workspace:FindFirstChildOfClass("Tool")

if not tool then
    warn("¡No se encontró ninguna Tool! Ten una herramienta en tu mochila, equipada o cerca de ti en el suelo.")
    return
end

-- Si la herramienta está en la mochila, la equipamos o la sacamos al workspace para controlarla físicamente
if tool.Parent == backpack then
    tool.Parent = character
    task.wait(0.1)
end

local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
if not handle then
    warn("La herramienta no tiene una parte física válida (Handle).")
    return
end

print("¡Utilizando la herramienta: " .. tool.Name .. "!")

-- 2. Configuración de Físicas y Network Ownership
pcall(function()
    -- Evitar que el sistema global de físicas entre en modo de suspensión
    settings().Physics.AllowSleep = false
end)

-- Reclamar propiedad de red para que tu cliente controle las físicas de la Tool
pcall(function()
    if handle:CanSetNetworkOwnership() then
        handle:SetNetworkOwner(LocalPlayer)
    end
end)

-- Ampliar el radio de simulación local mediante propiedades ocultas
pcall(function()
    sethiddenproperty(LocalPlayer, "SimulationRadius", 9e9)
    sethiddenproperty(LocalPlayer, "MaximumSimulationRadius", 9e9)
end)

-- 3. Parámetros de la órbita
local radius = 6  -- Distancia de separación (en studs)
local speed = 8   -- Velocidad de rotación

-- 4. Bucle de actualización por frame (RenderStepped)
local connection
connection = RunService.RenderStepped:Connect(function()
    if not character or not character:FindFirstChild("HumanoidRootPart") or not handle or not handle.Parent then
        if connection then connection:Disconnect() end
        return
    end

    local rootPart = character.HumanoidRootPart

    -- Forzar la propiedad oculta para evitar que el motor "duerma" la pieza
    pcall(function()
        sethiddenproperty(handle, "NetworkIsSleeping", false)
    end)

    -- Calcular la posición circular usando trigonometría y el tiempo actual
    local timeElapsed = tick() * speed
    local x = math.cos(timeElapsed) * radius
    local z = math.sin(timeElapsed) * radius

    -- Definir la CFrame objetivo alrededor del personaje (a la altura del torso)
    local targetCFrame = rootPart.CFrame * CFrame.new(x, 0, z)

    -- Aplicar posición y anular inercias/velocidades para evitar tirones de físicas
    handle.CFrame = targetCFrame
    handle.AssemblyLinearVelocity = Vector3.zero
    handle.AssemblyAngularVelocity = Vector3.zero
end)

print("¡Órbita activada correctamente!")
