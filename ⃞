-- Sistema de CFrame Fly optimizado para hachiware.cc
local FLYING = false
local flyConnection = nil

local function getRoot(char)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
end

local function unmobilefly(speaker)
    FLYING = false
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    
    workspace.Gravity = 192
    
    local char = speaker.Character
    local root = getRoot(char)
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
    end
end

local function mobilefly(speaker)
    unmobilefly(speaker)
    FLYING = true
    workspace.Gravity = 0
    
    local playerScripts = speaker:FindFirstChild("PlayerScripts") or speaker:WaitForChild("PlayerScripts")
    local success, controlModule = pcall(function()
        return require(playerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
    end)

    flyConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not FLYING then return end
        
        local char = speaker.Character
        local currentRoot = getRoot(char)
        local currentCamera = workspace.CurrentCamera
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if humanoid and currentRoot then
            humanoid.PlatformStand = true
            
            local moveVector = success and controlModule:GetMoveVector() or Vector3.zero
            local moveVelocity = Vector3.zero
            local speed = Config.FlySpeed * 60 -- Multiplicador de velocidad ajustable desde la UI
            
            if moveVector.X ~= 0 or moveVector.Z ~= 0 then
                moveVelocity = (currentCamera.CFrame.RightVector * moveVector.X) - (currentCamera.CFrame.LookVector * moveVector.Z)
            end
            
            -- Actualización directa de CFrame manteniendo la rotación de la cámara
            currentRoot.CFrame = CFrame.new(currentRoot.Position + (moveVelocity * speed * deltaTime)) * currentCamera.CFrame.Rotation
            currentRoot.AssemblyLinearVelocity = Vector3.zero
            currentRoot.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end
