local Players = game:GetService("Players")
local Player = Players.LocalPlayer

local function hidprot(instance, property, value)
    if sethiddenproperty then
        sethiddenproperty(instance, property, value)
        return
    end
    if not setscriptable then return end
    pcall(function()
        setscriptable(instance, property, true)
        instance[property] = value
        setscriptable(instance, property, false)
    end)
end

local InvisibleActive = false
local HideSpot = nil

-- Crear la parte invisible de destino para la física
local function SetupHideSpot()
    if HideSpot and HideSpot.Parent then return HideSpot end
    HideSpot = Instance.new("Part")
    HideSpot.CanCollide = false
    HideSpot.Anchored = true
    HideSpot.Transparency = 1
    HideSpot.Size = Vector3.new(1, 2, 1)
    -- Puedes cambiar esta posición a donde quieras mandar la física (ej. muy lejos o bajo el mapa)
    HideSpot.Position = Vector3.new(0, -500, 0)
    HideSpot.Name = "InvisiblePhysicsPart"
    HideSpot.Parent = workspace
    return HideSpot
end

local function ToggleInvisible()
    InvisibleActive = not InvisibleActive
    
    local Char = Player.Character
    local RootPart = Char and Char:FindFirstChild("HumanoidRootPart")
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    
    if InvisibleActive then
        if not RootPart then return end
        local spot = SetupHideSpot()
        
        task.spawn(function()
            while InvisibleActive and Char and Char.Parent do
                local currentRoot = Char:FindFirstChild("HumanoidRootPart")
                if currentRoot and spot then
                    currentRoot.Velocity = Vector3.zero
                    currentRoot.RotVelocity = Vector3.zero
                    
                    if Hum then 
                        Hum:ChangeState(Enum.HumanoidStateType.None) 
                    end
                    
                    -- Aplicar el método de tu script funcional
                    hidprot(currentRoot, "PhysicsRepRootPart", spot)
                end
                task.wait()
            end
        end)
    else
        if RootPart then
            pcall(function()
                hidprot(RootPart, "PhysicsRepRootPart", nil)
            end)
        end
        if HideSpot then
            HideSpot:Destroy()
            HideSpot = nil
        end
    end
end

-- Auto-activar al cargar el personaje
Player.CharacterAdded:Connect(function(newChar)
    InvisibleActive = false
    task.wait(1)
    ToggleInvisible() -- Se activa automáticamente al reaparecer (opcional)
end)

-- Ejecutar por primera vez
task.spawn(function()
    while not (Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")) do
        task.wait(0.1)
    end
    ToggleInvisible()
end)
