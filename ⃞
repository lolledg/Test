local players = game:GetService("Players")
local runservice = game:GetService("RunService")

local client = players.LocalPlayer
local character = client.Character or client.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- Creamos un Dummy de referencia para el PhysicsRepRootRef
local dummyPart = Instance.new("Part")
dummyPart.Size = Vector3.new(2, 2, 2)
dummyPart.Transparency = 1
dummyPart.CanCollide = false
dummyPart.Anchored = true
dummyPart.CFrame = hrp.CFrame
dummyPart.Parent = workspace

local debounce = 0
local sleepnet = true

-- Bucle optimizado de Desync
task.spawn(function()
    while true do
        debounce += 1
        
        -- Guardar estado actual
        local oldpos = hrp.CFrame
        local oldvel = hrp.AssemblyLinearVelocity

        if not sleepnet then
            -- Forzar separación de posición en el buffer de red
            hrp.CFrame = hrp.CFrame + Vector3.new(55, 0, 5)
            
            -- Aplicar PhysicsRepRootRef para engañar al replicador de físicas
            pcall(function()
                sethiddenproperty(hrp, "PhysicsRepRootRef", InstanceHandle.new(dummyPart))
            end)
        else
            pcall(function()
                sethiddenproperty(hrp, "PhysicsRepRootRef", InstanceHandle.new(hrp))
            end)
        end

        -- Alternar el estado de sueño de red
        sethiddenproperty(hrp, "NetworkIsSleeping", sleepnet)
        
        -- Restaurar posición visual local
        hrp.CFrame = oldpos

        runservice.RenderStepped:Wait()

        -- Control de ciclos para alternar el desync
        if debounce >= 3 then
            sleepnet = false
            debounce = 0 
            dummyPart.CFrame = hrp.CFrame -- Actualizar posición del dummy de anclaje
        else
            sleepnet = true
        end

        runservice.Heartbeat:Wait()
    end
end)
