local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- ==========================================
-- 1. CREAR LA INTERFAZ (LOS BOTONES)
-- ==========================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ControlDummyAndSync"
local success = pcall(function() ScreenGui.Parent = CoreGui end)
if not success then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

-- Botón principal para activar/desactivar el Dummy NaN
local ToggleButton = Instance.new("TextButton")
ToggleButton.Size = UDim2.new(0, 200, 0, 50)
ToggleButton.Position = UDim2.new(0.5, -100, 0.9, -120)
ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextScaled = true
ToggleButton.Text = "Activar Dummy NaN"
ToggleButton.Parent = ScreenGui

local UICorner1 = Instance.new("UICorner")
UICorner1.CornerRadius = UDim.new(0, 8)
UICorner1.Parent = ToggleButton

-- Botón para actualizar/sincronizar posición (Basado en la lógica del juego)
local SyncButton = Instance.new("TextButton")
SyncButton.Size = UDim2.new(0, 200, 0, 40)
SyncButton.Position = UDim2.new(0.5, -100, 0.9, -65)
SyncButton.BackgroundColor3 = Color3.fromRGB(40, 120, 200)
SyncButton.TextColor3 = Color3.fromRGB(255, 255, 255)
SyncButton.TextScaled = true
SyncButton.Text = "Actualizar Posición"
SyncButton.Parent = ScreenGui

local UICorner2 = Instance.new("UICorner")
UICorner2.CornerRadius = UDim.new(0, 8)
UICorner2.Parent = SyncButton

-- ==========================================
-- 2. VARIABLES Y FUNCIÓN DE ACTUALIZACIÓN
-- ==========================================
local activo = false
local dummy = nil
local heartbeatConnection = nil
local speed = 75 -- Velocidad con WASD
local accumulator = 0

local function actualizarPosicionReal(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = char.HumanoidRootPart
    
    -- Lógica idéntica al script del juego: limpiar físicas para evitar tirones o rechazo del servidor[span_2](start_span)[span_2](end_span)
    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    
    if char.PrimaryPart then
        char:PivotTo(targetCFrame) --[span_3](start_span)[span_3](end_span)
    end
    rootPart.CFrame = targetCFrame --[span_4](start_span)[span_4](end_span)
end

local function crearDummy()
    local part = Instance.new("Part")
    part.Size = Vector3.new(2, 2, 2)
    part.Color = Color3.new(1, 0, 0)
    part.Transparency = 0.5
    part.CanCollide = false
    part.Anchored = true
    part.CFrame = hrp.CFrame
    part.Parent = workspace
    return part
end

-- ==========================================
-- 3. EVENTOS DE LOS BOTONES
-- ==========================================

-- Botón de Sincronización Manual
SyncButton.MouseButton1Click:Connect(function()
    character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        if dummy then
            -- Si el dummy está activo, te teletransporta a su posición de forma sincronizada
            actualizarPosicionReal(dummy.CFrame)
        else
            -- Si no está activo, refresca y reestablece tu posición actual limpiando inercias
            actualizarPosicionReal(character.HumanoidRootPart.CFrame)
        end
    end
end)

-- Botón de Activación / Desactivación del Dummy NaN
ToggleButton.MouseButton1Click:Connect(function()
    activo = not activo
    
    if activo then
        ToggleButton.Text = "Desactivar Dummy"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        
        character = LocalPlayer.Character
        hrp = character:WaitForChild("HumanoidRootPart")
        
        dummy = crearDummy()
        local currentPos = dummy.Position
        
        heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
            if not dummy or not dummy.Parent then return end
            
            -- [A] MOVIMIENTO CON CFRAME (WASD + Cámara)
            local cam = workspace.CurrentCamera
            local moveDir = Vector3.new(0, 0, 0)

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit
            end
            
            currentPos = currentPos + (moveDir * speed * deltaTime)
            
            -- [B] GIRO EXTREMO / NaN SEGURO (Evita errores de intervalo)
            accumulator = accumulator + (deltaTime * 500000)
            dummy.CFrame = CFrame.new(currentPos) * CFrame.Angles(accumulator, accumulator * 1.5, accumulator * 2)
            
            -- [C] ATTACH Y ACTUALIZACIÓN USANDO LA LÓGICA SEGURA
            pcall(function()
                sethiddenproperty(hrp, "PhysicsRepRootRef", InstanceHandle.new(dummy))
                actualizarPosicionReal(dummy.CFrame)
                hrp.AssemblyAngularVelocity = Vector3.new(9e9, 9e9, 9e9)
                hrp.AssemblyLinearVelocity = Vector3.new(9e9, 9e9, 9e9)
            end)
        end)
    else
        ToggleButton.Text = "Activar Dummy NaN"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        
        if heartbeatConnection then heartbeatConnection:Disconnect() end
        if dummy then dummy:Destroy() end
        
        pcall(function()
            if hrp then
                sethiddenproperty(hrp, "PhysicsRepRootRef", InstanceHandle.new(hrp))
                hrp.AssemblyAngularVelocity = Vector3.new(0,0,0) 
                hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
            end
        end)
    end
end)
