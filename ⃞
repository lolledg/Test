local players = game:GetService("Players")
local runservice = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local client = players.LocalPlayer
local character = client.Character or client.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- ==========================================
-- 1. CREAR INTERFAZ PARA MÓVIL (TÁCTIL)
-- ==========================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DesyncMobileGui"
local success = pcall(function() ScreenGui.Parent = CoreGui end)
if not success then ScreenGui.Parent = client:WaitForChild("PlayerGui") end

-- Contenedor superior para no estorbar el joystick
local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 300, 0, 45)
Frame.Position = UDim2.new(0.5, -150, 0.05, 0) -- Arriba, centrado
Frame.BackgroundTransparency = 1
Frame.Parent = ScreenGui

-- Botón 1: Actualizar Posición
local UpdateButton = Instance.new("TextButton")
UpdateButton.Size = UDim2.new(0.48, 0, 1, 0)
UpdateButton.Position = UDim2.new(0, 0, 0, 0)
UpdateButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
UpdateButton.TextColor3 = Color3.fromRGB(255, 255, 255)
UpdateButton.TextScaled = true
UpdateButton.Text = "Actualizar Pos"
UpdateButton.Parent = Frame

local UICorner1 = Instance.new("UICorner")
UICorner1.CornerRadius = UDim.new(0, 8)
UICorner1.Parent = UpdateButton

-- Botón 2: Modo Combate (Pausar Desync)
local CombatButton = Instance.new("TextButton")
CombatButton.Size = UDim2.new(0.48, 0, 1, 0)
CombatButton.Position = UDim2.new(0.52, 0, 0, 0)
CombatButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
CombatButton.TextColor3 = Color3.fromRGB(255, 255, 255)
CombatButton.TextScaled = true
CombatButton.Text = "Desync: ON"
CombatButton.Parent = Frame

local UICorner2 = Instance.new("UICorner")
UICorner2.CornerRadius = UDim.new(0, 8)
UICorner2.Parent = CombatButton

-- ==========================================
-- 2. VARIABLES Y LÓGICA
-- ==========================================
local dummyPart = Instance.new("Part")
dummyPart.Size = Vector3.new(2, 2, 2)
dummyPart.Transparency = 1
dummyPart.CanCollide = false
dummyPart.Anchored = true
dummyPart.CFrame = hrp.CFrame
dummyPart.Parent = workspace

local isAttacking = false -- Variable que controla el bypass táctil

local function actualizarPosicionReal(targetCFrame)
    local char = client.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = char.HumanoidRootPart
    
    -- Limpieza de físicas
    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    
    if char.PrimaryPart then
        char:PivotTo(targetCFrame)
    end
    rootPart.CFrame = targetCFrame
    dummyPart.CFrame = targetCFrame
end

-- ==========================================
-- 3. EVENTOS TÁCTILES
-- ==========================================
UpdateButton.MouseButton1Click:Connect(function()
    actualizarPosicionReal(dummyPart.CFrame)
end)

CombatButton.MouseButton1Click:Connect(function()
    isAttacking = not isAttacking
    
    if isAttacking then
        -- Desync apagado temporalmente para poder atacar
        CombatButton.Text = "Desync: PAUSADO"
        CombatButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0) -- Verde = listo para golpear
    else
        -- Desync reactivado
        CombatButton.Text = "Desync: ON"
        CombatButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- Rojo = intocable
    end
end)

-- ==========================================
-- 4. BUCLE DE DESYNC ADAPTADO
-- ==========================================
local debounce = 0
local sleepnet = true

task.spawn(function()
    while true do
        character = client.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            hrp = character.HumanoidRootPart
            local oldpos = hrp.CFrame

            -- Si "Desync: ON" (isAttacking = false), aplicamos desync normal
            if not isAttacking then
                debounce += 1
                
                if not sleepnet then
                    hrp.CFrame = hrp.CFrame + Vector3.new(55, 0, 5)
                    pcall(function() sethiddenproperty(hrp, "PhysicsRepRootRef", InstanceHandle.new(dummyPart)) end)
                else
                    pcall(function() sethiddenproperty(hrp, "PhysicsRepRootRef", InstanceHandle.new(hrp)) end)
                end

                sethiddenproperty(hrp, "NetworkIsSleeping", sleepnet)
                hrp.CFrame = oldpos

                if debounce >= 3 then
                    sleepnet = false
                    debounce = 0 
                    dummyPart.CFrame = hrp.CFrame
                else
                    sleepnet = true
                end
            else
                -- Si "Desync: PAUSADO" (Verde), sincronizamos para el combate
                pcall(function() sethiddenproperty(hrp, "PhysicsRepRootRef", InstanceHandle.new(hrp)) end)
                sethiddenproperty(hrp, "NetworkIsSleeping", false)
                dummyPart.CFrame = hrp.CFrame
            end
        end

        runservice.RenderStepped:Wait()
        runservice.Heartbeat:Wait()
    end
end)
