Local Character = game:GetService("Players").LocalPlayer.Character
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart",9e9)

local HideSpot = Instance.new("Part")
HideSpot.CanCollide = false
HideSpot.Anchored = true
HideSpot.Transparency = 1
HideSpot.Size = Vector3.new(1,2,1)
HideSpot.Position = Vector3.new(0/0,0/0,0/0)
HideSpot.Name = "Part"
HideSpot.Parent = workspace

local d = 0
local synced = false
task.spawn(function()
    while game:GetService("Players").LocalPlayer.Character == Character and task.wait(0) do 
        if synced then task.wait() continue end
        if d <= 0 then
            synced = true
            pcall(sethiddenproperty, HumanoidRootPart, "PhysicsRepRootRef", nil)
               task.wait(0)
            pcall(sethiddenproperty, HumanoidRootPart, "PhysicsRepRootRef", HideSpot)
            synced = false
            d = 1
        else
            d = d - 1
            pcall(sethiddenproperty, HumanoidRootPart, "PhysicsRepRootRef", HideSpot)
        end
    end
end)
