local ReplicatedStorage = game:GetService("ReplicatedStorage")
local killClient = ReplicatedStorage:FindFirstChild("KillClient")

if killClient then
    task.spawn(function()
        print("Iniciando spam de muertes...")
        -- Cambia el número 100 por la cantidad que quieras (o usa un while true para bucle infinito)
        for i = 1, 10000 do
            task.spawn(function()
                pcall(function()
                    killClient:InvokeServer()
                end)
            end)
            task.wait(0) -- Pequeña pausa para evitar que el juego crashee de golpe
        end
        print("¡Proceso finalizado!")
    end)
else
    warn("No se encontró KillClient en ReplicatedStorage.")
end
